{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "unicorn",
    "oxc",
    "import",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**"
  ],
  "rules": {
    "react/refs": "warn",
    "react/set-state-in-effect": "warn"
  }
}
