# Birthday Invitation — environment variables
# Copy to .env and fill in. These are injected into the frontend at container
# start (see infra/inject-env.sh) and consumed by docker compose.
#
# The app is multi-event: the admin (/admin) creates and manages any number of
# events, each with its own theme, invitation link (/e/<slug>), QR code and
# RSVP list. The BIRTHDAY_* / EVENT_* values below seed the *default* event
# (served at /) on first start; once you edit that event in the admin, these are
# no longer applied. New events are created entirely from the admin UI.

# Birthday person's name (seeds the default event)
BIRTHDAY_PERSON=Léo

# Birthday person's age
BIRTHDAY_AGE=5

# Event date (YYYY-MM-DD)
EVENT_DATE=2025-09-06

# Event time
EVENT_TIME=15h00 - 17h00

# Town
EVENT_TOWN=Artigues-près-Bordeaux

# Event location / address
EVENT_LOCATION=🏠 Chez Léo - 1 rue Exemple, 33370 Artigues-près-Bordeaux

# Dress code
DRESS_CODE=Tenue de rechange ou maillot de bain ! Il y aura des jeux d'eau 💦

# Optional "respond by" date (YYYY-MM-DD). When set and passed, the invitation
# shows that RSVPs are closed and the API rejects new submissions. Leave blank
# to keep RSVPs open indefinitely.
EVENT_RSVP_DEADLINE=

# Base domain used by the Traefik router (compose.yml) -> birthday.${DOMAIN}
DOMAIN=example.com

# Optional comma-separated allow-list of cross-origin sites permitted to call the
# API. Leave blank for the default same-origin-only behaviour.
CORS_ORIGIN=

# Database backup sidecar (compose.yml "backup" service).
# BACKUP_KEEP: number of snapshots to retain. BACKUP_INTERVAL: seconds between runs.
BACKUP_KEEP=14
BACKUP_INTERVAL=86400

# Bootstrap admin (Better Auth). Registration is open — anyone can create an
# account with an email/password or with Google — but a new account gets no
# access until an admin grants it from /admin. This is the one account that
# starts with the admin role, seeded from ADMIN_EMAIL / ADMIN_PASSWORD on first
# start. The password of an existing account is never changed by a restart, but
# the admin role is re-granted on every boot so you cannot lock yourself out.
# Password must be at least 8 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-secret
# Optional display name for the seeded admin (defaults to "Admin").
ADMIN_NAME=Admin

# --- Transactional email (Resend) -------------------------------------------
# Email/password sign-up is gated on a confirmation link, and password resets
# need the same transport, so this is REQUIRED: the server refuses to start in
# production without MAIL_FROM and a credential. Locally, leaving them blank
# falls back to logging each email (link included) instead of sending it.
#
# Create an API key at https://resend.com/api-keys and verify the sending
# domain — Resend rejects a MAIL_FROM on an unverified domain.
MAIL_FROM=Invitation <invitation@example.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Resend's SMTP bridge. The defaults below are correct for Resend; override only
# to point at a different SMTP provider (SMTP_PASS replaces RESEND_API_KEY).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend

# --- Google sign-in ----------------------------------------------------------
# Optional. Leave both blank to hide the "Continuer avec Google" button.
# Create an OAuth 2.0 Client ID (type "Web application") in the Google Cloud
# console and add this exact authorized redirect URI:
#   https://birthday.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session signing secret for Better Auth. REQUIRED in production (the server
# refuses to start without it). Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Public origin the app is served from, used by Better Auth to validate request
# origins and scope session cookies. Behind a proxy (Traefik) set this to the
# external HTTPS URL, e.g. https://birthday.example.com. May be left blank
# for same-origin local development.
BETTER_AUTH_URL=

# Public origin used to build absolute URLs in the page metadata (canonical,
# og:url, sitemap). Defaults to BETTER_AUTH_URL, then to the request's own host.
# e.g. https://birthday.example.com
PUBLIC_BASE_URL=

# Set to false to keep the invitation out of search engines (serves noindex and
# a blanket "Disallow: /" in robots.txt). Chat link previews are unaffected.
SEO_ALLOW_INDEXING=true

# Number of proxy hops in front of the backend, used for per-IP rate limiting.
# Default 1 matches the Traefik -> Node chain. Set 0 for direct access.
TRUST_PROXY=1
